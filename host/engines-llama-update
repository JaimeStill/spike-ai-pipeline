#!/usr/bin/env bash
# engines:summary=Move llama to the pinned build or the version given, and remove every other image
# Moves llama to the pinned image, or to the image for the version given, as install reads it: a
# semver release, such as v0.6.0, runs the b-build its notes name (llama-release.sh), and a
# b-build, such as b11429, runs as given. It pulls that image before replacing the container, so
# a failed pull leaves the old build serving. The container is replaced when its image isn't that
# one or its preset mount isn't the clone's preset directory (as after the clone's scripts move);
# one replacement handles both, and when the image is already that one it pulls nothing. A
# replaced container runs, even if the old one was stopped. When llama already runs that image
# with the clone's preset and no other image is left, it changes nothing; when that container is
# stopped, it says docker start starts it, and never starts it itself. It refuses while the vllm
# container runs or native llama.cpp's llama-router unit is active, since one engine serves per
# host at a time. It refuses a version that is neither, or a release whose notes it can't read,
# before it reads Docker.
set -euo pipefail
# shellcheck source=host/llama.sh
source "$(dirname "$(readlink -f -- "${BASH_SOURCE[0]}")")/llama.sh"

build=$(llama_build "${1:-}")
engines_refuse_running vllm
engines_refuse_unit llama-router

image=$(llama_image "$build")
running=$(llama_running_image)
if [[ -z $running ]]; then
  echo "llama is not installed; engines llama install installs it" >&2
  exit 1
fi

mount=$(llama_preset_mount)
changed=
if [[ $running != "$image" || $mount != "$LLAMA_PRESET_DIR" ]]; then
  llama_preflight
  [[ $running == "$image" ]] || docker pull "$image"
  docker rm --force "$LLAMA_CONTAINER" >/dev/null
  llama_run "$image" >/dev/null
  if [[ $mount == "$LLAMA_PRESET_DIR" ]]; then
    echo "llama moved from $running to $image"
  elif [[ $running == "$image" ]]; then
    echo "llama restarted $image with its preset mount moved from ${mount:-none}" \
      "to $LLAMA_PRESET_DIR"
  else
    echo "llama moved from $running to $image, and its preset mount from ${mount:-none}" \
      "to $LLAMA_PRESET_DIR"
  fi
  changed=yes
fi
removed=$(llama_remove_images "$image")
[[ -n $removed ]] && echo "$removed"
stopped=
[[ -n $changed ]] || stopped=$(engines_stopped "$LLAMA_CONTAINER")
if [[ -n $stopped ]]; then
  echo "llama is installed with $image but stopped; docker start llama starts it"
elif [[ -z $changed$removed ]]; then
  echo "llama already runs $image; nothing changed"
fi
