#!/usr/bin/env bash
# engines:summary=Run llama-server in router mode, at the pinned build or the version given
# Starts the llama container (llama.sh) from the pinned image, or from the image for the version
# given: a semver release, such as v0.6.0, runs the b-build its notes name (llama-release.sh), and
# a b-build, such as b11429, runs as given. When the container already runs that image, with the
# clone's preset directory mounted, it changes nothing, saying docker start starts it when it is
# stopped (it never starts it itself). When the container runs another image, or mounts the
# preset from anywhere else (as after the clone's scripts move), it refuses, saying what it runs
# or mounts, and points at update. It refuses while the vllm container runs or native llama.cpp's
# llama-router unit is active, since one engine serves per host at a time. It refuses a version
# that is neither, or a release whose notes it can't read, before it reads Docker.
set -euo pipefail
# shellcheck source=host/llama.sh
source "$(dirname "$(readlink -f -- "${BASH_SOURCE[0]}")")/llama.sh"

build=$(llama_build "${1:-}")
engines_refuse_running vllm
engines_refuse_unit llama-router
# The update that moves it to what install was asked for: the pin, or the version given.
update="engines llama update${1:+ $1} moves it to ${1:-the pin}"

image=$(llama_image "$build")
running=$(llama_running_image)
mount=
[[ -z $running ]] || mount=$(llama_preset_mount)

if [[ -n $running && $mount != "$LLAMA_PRESET_DIR" ]]; then
  echo "llama's preset mount is ${mount:-none}, not $LLAMA_PRESET_DIR;" \
    "$update" >&2
  exit 1
elif [[ $running == "$image" ]]; then
  stopped=$(engines_stopped "$LLAMA_CONTAINER")
  if [[ -n $stopped ]]; then
    echo "llama is installed with $image but stopped; docker start llama starts it"
  else
    echo "llama already runs $image; nothing changed"
  fi
  exit 0
elif [[ -n $running ]]; then
  echo "llama runs $running, not $image; $update" >&2
  exit 1
fi

llama_preflight
docker pull "$image"
llama_run "$image" >/dev/null
echo "llama runs $image on port 8080 of the tailnet address"
