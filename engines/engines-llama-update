#!/usr/bin/env bash
# engines:summary=Move llama to the pinned build and remove every other llama.cpp image
# Pulls the pinned image before replacing the container, so a failed pull leaves the old build
# serving. When llama already runs the pin and no other image is left, it changes nothing; when the
# pin's container is stopped, it says docker start starts it, and never starts it itself. It
# refuses while the vllm container runs, since one engine serves per host at a time.
set -euo pipefail
# shellcheck source=engines/llama.sh
source "$(dirname "$(readlink -f -- "${BASH_SOURCE[0]}")")/llama.sh"

engines_refuse_running vllm

running=$(llama_running_image)
if [[ -z $running ]]; then
  echo "llama is not installed; engines llama install installs it" >&2
  exit 1
fi

changed=
if [[ $running != "$LLAMA_IMAGE" ]]; then
  llama_preflight
  docker pull "$LLAMA_IMAGE"
  docker rm --force "$LLAMA_CONTAINER" >/dev/null
  llama_run "$LLAMA_IMAGE" >/dev/null
  echo "llama moved from $running to $LLAMA_IMAGE"
  changed=yes
fi
removed=$(llama_remove_images "$LLAMA_IMAGE")
[[ -n $removed ]] && echo "$removed"
stopped=
[[ -n $changed ]] || stopped=$(engines_stopped "$LLAMA_CONTAINER")
if [[ -n $stopped ]]; then
  echo "llama is installed with $LLAMA_IMAGE but stopped; docker start llama starts it"
elif [[ -z $changed$removed ]]; then
  echo "llama already runs $LLAMA_IMAGE; nothing changed"
fi
