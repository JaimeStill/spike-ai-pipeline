#!/usr/bin/env bash
# engines:summary=Run llama-server in router mode, at the pinned build or the b-build given
# Starts the llama container (llama.sh) from the pinned image, or from the b-build given, such as
# b11429. When the container already exists it changes nothing and says which image it runs, or,
# when it is stopped, that docker start starts it; it never starts it itself. It refuses while
# the vllm container runs, since one engine serves per host at a time.
set -euo pipefail
# shellcheck source=engines/llama.sh
source "$(dirname "$(readlink -f -- "${BASH_SOURCE[0]}")")/llama.sh"

engines_refuse_running vllm

image=$(llama_image "${1:-$LLAMA_BUILD}")
running=$(llama_running_image)

if [[ $running == "$image" ]]; then
  stopped=$(engines_stopped "$LLAMA_CONTAINER")
  if [[ -n $stopped ]]; then
    echo "llama is installed with $image but stopped; docker start llama starts it"
  else
    echo "llama already runs $image; nothing changed"
  fi
  exit 0
elif [[ -n $running ]]; then
  echo "llama runs $running, not $image; engines llama update moves it to the pin" >&2
  exit 1
fi

llama_preflight
docker pull "$image"
llama_run "$image" >/dev/null
echo "llama runs $image on port 8080 of the tailnet address"
